// Test-only build: compiles the pure-computation modules (lib/stats, lib/wonder) to
// CommonJS in .test-out/ so Node's built-in test runner can execute them.
// The app itself is unaffected (tsconfig.json stays noEmit).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-out",
    "types": ["node"]
  },
  "include": ["lib/stats/**/*.ts", "lib/wonder/**/*.ts", "lib/analysis/**/*.ts", "lib/insights.ts", "lib/describeSpec.ts", "lib/tableUtils.ts", "lib/chartAxes.ts", "lib/chartAxes.test.ts", "lib/wonderHealth.ts", "lib/wonderHealth.test.ts", "lib/queryLog.ts", "lib/queryLog.test.ts"]
}
